# Copy to .env and fill in your key:  cp .env.example .env
OPENAI_API_KEY=your_openai_api_key_here

# ---- Models (must be available to your OpenAI project)
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# whisper-1                 -> segment timestamps + language
# gpt-4o-transcribe-diarize -> segment timestamps + speaker labels
# gpt-4o-mini-transcribe    -> text only (timed by TIMESTAMP_FALLBACK_SECONDS audio pieces)
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VISION_MODEL=gpt-4.1-mini
# Optional: sampling temperature for answers. Leave blank to use the model's default.
OPENAI_CHAT_TEMPERATURE=0.1

# ---- ChromaDB (one folder, four collections)
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=vpro_document_knowledge
CHROMA_AUDIO_COLLECTION=vpro_audio_transcripts
CHROMA_VIDEO_TRANSCRIPT_COLLECTION=vpro_video_transcripts
CHROMA_VIDEO_FRAME_COLLECTION=vpro_video_frames

# ---- Document RAG (PDF / Excel / Word / TXT)
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MAX_UPLOAD_SIZE_MB=20

# ---- Audio / video processing (examples, not OpenAI limits)
# Split length for models that return timestamps (each piece must stay under the 25 MB API limit).
AUDIO_CHUNK_SECONDS=300
# Split length for text-only transcription models: smaller = finer timestamps, more requests.
TIMESTAMP_FALLBACK_SECONDS=30
# Optional ISO-639-1 language hint (e.g. en) and vocabulary prompt for better spelling of terms.
TRANSCRIPTION_LANGUAGE=
TRANSCRIPTION_PROMPT=VPro Skills EduTech, RAG, ChromaDB, embeddings
VIDEO_FRAME_INTERVAL_SECONDS=10
MAX_FRAMES_PER_VIDEO=500
MAX_MEDIA_UPLOAD_SIZE_MB=200
MAX_MEDIA_DURATION_MINUTES=180
MEDIA_TOP_K=5

# ---- FFmpeg (only needed if ffmpeg/ffprobe are not on PATH)
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_TIMEOUT_SECONDS=600
