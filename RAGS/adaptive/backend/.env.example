# Required for chat and indexing. Never commit a real key.
OPENAI_API_KEY=

# Models
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector store (relative paths resolve against the backend/ directory)
CHROMA_PERSIST_DIRECTORY=./storage/chroma
CHROMA_COLLECTION_NAME=vpro_adaptive_rag

# Chunking and retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
# Minimum cosine similarity (0..1) a chunk needs to be used as answer context
RELEVANCE_THRESHOLD=0.35

# Generation
ANSWER_TEMPERATURE=0.2
MAX_HISTORY_TURNS=6

# Server
FRONTEND_ORIGIN=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
