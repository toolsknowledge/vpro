							"content": [
								{
									"type": "text",
									"text": "        # compare \"username\" with \"db username\""
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "        existed_user = users.find_one({\"username\":user.username})           # existed_user - db (_id, username & hash password)"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "        print(existed_user)"
								}
							]
						},
