							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "if(existed_user is None or not password_hash.verify(user.password,existed_user[\"password\"])):"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "raise HTTPException(status_code=401,detail=\"username or password not matches !!!\")"
								}
							]
						},
